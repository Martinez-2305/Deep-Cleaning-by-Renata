# One address for the whole site: https://deepcleaningbyrenata.co.uk (matches the canonical
# URLs, hreflang links and sitemap). Hostinger handles HTTP → HTTPS; this sends www to the
# plain domain. (No HTTPS check here: behind a CDN it could cause a redirect loop.)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://deepcleaningbyrenata.co.uk%{REQUEST_URI} [R=301,L]

# /index.html and /pl/index.html are the same pages as / and /pl/.
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Make sure AVIF photos are sent as images (older servers don't know the type).
AddType image/avif .avif

# Branded "page not found" page (the Polish one is linked from it).
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Browsers only ever use HTTPS for this site (one year).
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # The site can't be shown inside another site's frame (clickjacking protection).
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# Fonts never change under the same name, so browsers can keep them for a year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
